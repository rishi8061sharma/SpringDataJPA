spring.application.name=hello-micro-service 
server.port=12345 

#JPA Properties
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

#Log Properties 
logging.level.root=INFO 
logging.level.com.hwlmsp=DEBUG 
logging.pattern.console=%-5level %logger{36} - %m %n


#management.endpoints.web.exposure.include=info,beans
#management.endpoints.web.exposure.include=health,info,beans
management.endpoints.web.exposure.include=*

management.endpoint.scheduledtasks.enabled=false
management.endpoint.caches.enabled=false

management.endpoints.web.exposure.exclude=conditions,configprops

spring.data.mongodb.database=myjlcdb5 
spring.data.mongodb.port=27017 
spring.data.mongodb.host=localhost
info.app.name=@project.name@ 
info.app.description=@project.description@ 
info.app.version=@project.version@ 
info.app.encoding=@project.build.sourceEncoding@ 
info.app.java.version=@java.version@ 
info.app.developer=Rishi Sharma 
info.app.company=HWL Advanced Technology Private Limited