package com.hwlmsp.springboot;

import org.springframework.boot.actuate.health.AbstractHealthIndicator; 
import org.springframework.boot.actuate.health.Health; 
import org.springframework.stereotype.Component;

@Component
public class MyCustomHealthIndicator extends AbstractHealthIndicator { 
	@Override 
	protected void doHealthCheck(Health.Builder builder) throws Exception { 
		 
	builder.up() 
	.withDetail("app", "App is Running Successfully") 
	.withDetail("error", "No Errors. App is dong good."); 
		/*builder.down() 
		.withDetail("app", "App is Crashed") 
		.withDetail("error", "Something Happened"); */
	}
}
